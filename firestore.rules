rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated(); // Allow any auth user to read profiles (needed for task assignment)
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; // Prevent accidental deletion
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Any auth user can post
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid || // Creator can edit
        resource.data.assignedTo == request.auth.uid || // Walker can update status
        resource.data.status == "open" // Required for accepting
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
